# Copy to .env and fill in. NEVER commit .env
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ---- M-Pesa Daraja (https://developer.safaricom.co.ke -> My Apps) ----
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox Lipa Na M-Pesa Online test shortcode + passkey (from the Daraja simulator page)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=174379

# Public HTTPS URL of this server (e.g. from `ngrok http 8000`) so Safaricom can send the callback
MPESA_CALLBACK_BASE_URL=https://your-subdomain.ngrok-free.app
# Random secret used in the callback path: python -c "import secrets;print(secrets.token_urlsafe(24))"
MPESA_CALLBACK_TOKEN=replace-me

# Sandbox only: charge KES 1 instead of the real order total (set 0 to charge the real total)
MPESA_TEST_CHARGE_AMOUNT=1

# ---- Pricing (keep USD_TO_KES_RATE equal to the app's Constants.USD_TO_KES_RATE) ----
USD_TO_KES_RATE=129
STANDARD_DELIVERY_FEE=200
EXPRESS_DELIVERY_FEE=450
FREE_DELIVERY_THRESHOLD=5000
